# ===== VARIÃVEIS OBRIGATÃ“RIAS =====
# JWT Secret - NUNCA use o valor padrÃ£o em produÃ§Ã£o!
# Gere uma chave segura com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="gere_uma_chave_segura_com_32_caracteres_minimo_aqui"

# ===== SERVIDOR =====
NODE_ENV=development
PORT=3000
HOST=localhost

# ===== BANCO DE DADOS =====
DB_PATH=../../db.json
DATABASE_URL="postgresql://usuario:senha@localhost:5432/neyes?schema=public"

# ===== JWT CONFIGURATION =====
JWT_EXPIRATION=8h

# ===== CORS =====
CORS_ORIGIN=http://localhost:3000,http://localhost:8000

# ===== SEGURANÃ‡A =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== LOGGING =====
LOG_LEVEL=info
LOG_FILE=logs/app.log
